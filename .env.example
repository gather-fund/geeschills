# Copy this file to .env.local and restart the development server.
# Add the same values in Vercel's environment settings before deploying.

# Private Resend API key. Replace locally; never commit a real key.
RESEND_API_KEY=

# Requires geeschills.com to be verified as a sending domain in Resend.
ENQUIRY_FROM_EMAIL="GEES CHILLS <enquiries@geeschills.com>"
ENQUIRY_TO_EMAIL=gloriaamankrahyeboah97@gmail.com

# Public WhatsApp number, including country code, digits only.
NEXT_PUBLIC_WHATSAPP_NUMBER=233277946635

# Optional Google Search Console HTML-tag verification token (public metadata).
GOOGLE_SITE_VERIFICATION=

# Cloudflare Turnstile bot check. Leave both empty to run without it; the server enforces it once
# the secret is set. Test keys that always pass: site 1x00000000000000000000AA,
# secret 1x0000000000000000000000000000000AA.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional Upstash Redis REST credentials for a rate limit shared across serverless instances.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Admin sign-in for /admin/ (invoices). Use a long, unique password (12+ characters).
ADMIN_PASSWORD=

# Google Sheet for confirmed orders: the Apps Script web app URL (ends in /exec) and a shared
# secret that matches the script's WEBHOOK_SECRET property. See ADMIN_SETUP.md.
SHEETS_WEBHOOK_URL=
SHEETS_WEBHOOK_SECRET=
